# 보드: WeMos LOLIN S3 V1.0.0 (ESP32-S3-WROOM-1, 16MB 플래시, 8MB 옥탈 PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# 플래시 16MB + 커스텀 파티션(OTA 슬롯 2개 + LittleFS)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8MB 옥탈 PSRAM (GPIO35~37은 PSRAM이 쓰므로 다른 용도로 쓰지 않는다)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# LOLIN S3의 USB-C는 칩 내장 USB(GPIO19/20)에 바로 연결되어 있다.
# 로그를 USB로 보려면 콘솔을 USB Serial/JTAG로 둔다.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 작업 워치독: 알람 작업이 5초 넘게 멈추면 리셋(계획 2)
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_FREERTOS_HZ=1000

# LVGL 글꼴: 시각 48, 나머지 24 (계획 2 Task 5)
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# SD카드 FAT: 긴 파일 이름(한글 포함, UTF-8)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_CODEPAGE_949=y

# 웹 서버(계획 4): 긴 URL(한글 파일 이름 퍼센트 인코딩)과 헤더
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# 웹 펌웨어 업데이트 롤백(계획 4): 새 펌웨어가 정상임을 확인하기 전에 리셋되면 이전 슬롯으로
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
