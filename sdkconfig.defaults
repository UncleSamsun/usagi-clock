# 보드: WeMos LOLIN S3 V1.0.0 (ESP32-S3-WROOM-1, 16MB 플래시, 8MB 옥탈 PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# 플래시 16MB + 커스텀 파티션(OTA 슬롯 2개 + LittleFS)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8MB 옥탈 PSRAM (GPIO35~37은 PSRAM이 쓰므로 다른 용도로 쓰지 않는다)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# LOLIN S3의 USB-C는 칩 내장 USB(GPIO19/20)에 바로 연결되어 있다.
# 로그를 USB로 보려면 콘솔을 USB Serial/JTAG로 둔다.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
